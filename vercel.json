{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/proxy.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/config", "destination": "/api/proxy?target=config" },
    { "source": "/api/:target(chaos|security|app)/:path*", "destination": "/api/proxy?target=:target&path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
